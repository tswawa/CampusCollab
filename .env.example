NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=data/campus.sqlite
# Optional installer credential: use 32+ random non-whitespace characters.
# If empty, an unconfigured instance generates DATABASE_PATH.setup-token (host access only).
# Installation permanently closes after success; this value never resets an installed instance.
SETUP_TOKEN=
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups
SESSION_TTL_SECONDS=604800
PRESESSION_TTL_SECONDS=1800
SCHOOL_TIMEZONE=Asia/Shanghai
# TRUST_PROXY: false, or the reverse proxy addresses to trust (IP addresses, CIDR ranges, loopback,
# linklocal or uniquelocal). true means a reverse proxy on this host (loopback). Hop counts are not accepted.
TRUST_PROXY=false
# 仅本机生产构建验收可设为 true；公网生产应使用 HTTPS。
ALLOW_INSECURE_COOKIE=false
# Optional notification email. Leave disabled until a deployment owner configures SMTP.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_POLL_INTERVAL_MS=15000
