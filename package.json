{
  "name": "campuscollab",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual campus task collaboration, evidence review and completion packages",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --port 5173",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "npm run type-check && vite build && tsc -p tsconfig.server.json && node scripts/package-source.mjs",
    "build:client": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "type-check": "npm run type-check:client && npm run type-check:server && npm run type-check:test",
    "format": "prettier --write \"{src,server,shared,tests,scripts}/**/*.{ts,vue,mjs,css}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"{src,server,shared,tests,scripts}/**/*.{ts,vue,mjs,css}\" \"*.{ts,mjs}\"",
    "type-check:client": "vue-tsc --noEmit -p tsconfig.app.json",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit",
    "type-check:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run test:api && npm run test:client && npm run test:e2e",
    "test:api": "node --test --test-concurrency=2 --import tsx server/tests/*.test.ts",
    "test:client": "tsx --tsconfig tsconfig.app.json --test src/mobile/**/*.test.ts",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "node scripts/test-e2e.mjs",
    "db:migrate": "node --env-file-if-exists=.env dist-server/server/scripts/migrate.js",
    "admin:init": "node --env-file-if-exists=.env dist-server/server/scripts/init-admin.js",
    "db:seed:demo": "node --env-file-if-exists=.env dist-server/server/scripts/seed-demo.js",
    "db:seed:workflow": "node --env-file-if-exists=.env dist-server/server/scripts/seed-workflow-demo.js",
    "db:backup": "node --env-file-if-exists=.env dist-server/server/scripts/backup.js",
    "db:restore": "node --env-file-if-exists=.env dist-server/server/scripts/restore.js",
    "files:cleanup": "node --env-file-if-exists=.env dist-server/server/scripts/cleanup-files.js",
    "mail:send": "node --env-file-if-exists=.env dist-server/server/scripts/send-mail.js",
    "template:preview": "node dist-server/server/scripts/template-preview.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@sinclair/typebox": "^0.34.52",
    "exceljs": "4.4.0",
    "fastify": "^5.12.3",
    "fflate": "0.8.3",
    "nodemailer": "10.0.16",
    "pinia": "^3.0.3",
    "sharp": "^0.35.4",
    "vant": "^4.9.20",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "8.0.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.4",
    "prettier": "3.9.10",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.0.1"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "shell-quote": "1.11.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
